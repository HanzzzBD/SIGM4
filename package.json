{
  "name": "sigm4",
  "private": true,
  "type": "module",
  "description": "SIGM4 — Sistem Informasi Management Aset, sarana dan prasarana sekolah",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . && npm run lint --workspaces --if-present",
    "typecheck": "tsc --build",
    "build": "npm run build --workspaces --if-present",
    "check:boundaries": "node scripts/check_import_boundaries.mjs",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:rollback": "node scripts/migrate.mjs down",
    "db:status": "node scripts/migrate.mjs status",
    "demo:seed": "npm run build --workspace=@sigm4/api && node scripts/seed-demo.mjs && node scripts/seed-demo-files.mjs",
    "demo:verify": "node scripts/verify-demo.mjs"
  },
  "dependencies": {
    "dbmate": "^2.37.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.12.0",
    "pg": "^8.23.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "~1.14.5"
    }
  }
}
