{
  "name": "@sigm4/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Pohon backend SIGM4 — entrypoint sigm4-api dan sigm4-worker dari satu basis kode (SDD-REPO-04)",
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint src",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ci": "tsc -p tsconfig.test.json && vitest run --config vitest.ci.config.ts --coverage --reporter=default --reporter=json --outputFile.json=./coverage-ci/vitest-report.json"
  },
  "dependencies": {
    "@sigm4/schemas": "*",
    "bullmq": "6.3.4",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "zod": "4.5.4",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "^8.23.1"
  }
}
