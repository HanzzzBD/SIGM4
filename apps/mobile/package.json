{
  "name": "@sigm4/mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Pohon mobile SIGM4 — Expo dev build (SDD-MOB-10, SDD-12 §4.1)",
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint src",
    "start": "expo start --dev-client",
