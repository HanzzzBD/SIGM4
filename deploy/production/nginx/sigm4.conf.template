# Nginx stack aplikasi di server sekolah — PR-00-18, PR-08-18, PR-08-19 (SDD-16 §4.2, SDD-INF-16).
#
# Dipakai stack staging DAN produksi (deploy/production/docker-compose.yml), dipanggang
# ke image sigm4-web (web.Dockerfile). TLS dan sertifikat milik nginx sekolah
# (SDD-INF-16 b), yang meneruskan HTTP polos ke port host container ini.
#
# Satu origin (keputusan 51): web statis di `/`, API di `/api/v1`. Peramban tidak
# pernah melakukan permintaan lintas origin, sehingga `cors` tidak dipasang.

# DNS internal Docker. Nama upstream diselesaikan ulang tiap 5 detik: instance API
# yang diganti `compose up` memperoleh IP baru, dan upstream yang hanya diselesaikan
# saat Nginx menyala akan terus menunjuk container yang sudah tidak ada.
resolver 127.0.0.11 valid=5s ipv6=off;

map $http_x_forwarded_proto $hsts {
    https   "max-age=31536000; includeSubDomains";
    default "";
}

upstream sigm4_api {
    zone sigm4_api 64k;
    # SDD-INF-13 — pemeriksaan PASIF Nginx OSS: instance yang gagal sekali dikeluarkan
    # 5 detik.
    server api-1:3000 resolve max_fails=1 fail_timeout=5s;
    server api-2:3000 resolve max_fails=1 fail_timeout=5s;
    keepalive 16;
}

server {
    listen 80;
    server_name _;

    # IP klien dari nginx sekolah. Port host container ini dapat dijangkau langsung, sehingga
    # X-Forwarded-For HANYA dipercaya dari alamat nginx sekolah (SIGM4_PROXY_CIDR): klien
    # yang menembak port langsung tidak dapat memalsukan IP-nya untuk lolos rate limit.
    # nginx sekolah MENIMPA header itu dengan satu alamat, sehingga API tetap melihat
    # satu hop (NFR-S-07).
    set_real_ip_from ${SIGM4_PROXY_CIDR};
    real_ip_header X-Forwarded-For;

    # Kompresi oleh reverse proxy, bukan aplikasi (SDD-06 §4.3).
    gzip on;
    gzip_types application/json text/css application/javascript image/svg+xml;

    # INF-06 — HSTS; dahulu dari proxy tepi. Hanya pada permintaan yang tiba di nginx
    # sekolah lewat HTTPS (X-Forwarded-Proto). Header keamanan API tetap milik
    # aplikasi (NFR-S-11).
    add_header Strict-Transport-Security $hsts always;

    location /api/ {
        proxy_pass http://sigm4_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Satu hop: `trust proxy 1` pada API membaca IP klien dari sini (NFR-S-07).
        proxy_set_header X-Forwarded-For $remote_addr;
        # Skema asli dari nginx sekolah (TLS berakhir di sana).
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        # Instance yang sedang diganti tidak boleh menjadi galat bagi pengguna.
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 2;
    }

    # Web statis (SDD-FE-14) — rute sisi klien jatuh ke index.html.
    location / {
        root /usr/share/sigm4/web;
        try_files $uri $uri/ /index.html =404;
    }
}
