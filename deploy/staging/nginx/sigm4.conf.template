# Nginx staging — PR-00-18 (INF-06, SDD-INF-13, SDD-16 §4.2).
#
# Template: entrypoint image nginx mengganti ${SIGM4_DOMAIN} saat container
# menyala. Variabel Nginx ($host, $remote_addr, …) tidak tersentuh karena hanya
# variabel lingkungan yang terdefinisi yang disubstitusi.
#
# Satu origin (keputusan 51): web statis di `/`, API di `/api/v1`. Peramban tidak
# pernah melakukan permintaan lintas origin, sehingga `cors` tidak dipasang.

# DNS internal Docker. Nama upstream diselesaikan ulang tiap 5 detik: instance API
# yang diganti deploy.sh memperoleh IP baru, dan upstream yang hanya diselesaikan
# saat Nginx menyala akan terus menunjuk container yang sudah tidak ada.
resolver 127.0.0.11 valid=5s ipv6=off;

upstream sigm4_api {
    zone sigm4_api 64k;
    # SDD-INF-13 — pemeriksaan PASIF Nginx OSS: instance yang gagal sekali dikeluarkan
    # 5 detik. Gerbang sebenarnya adalah readiness gate deploy.sh (SDD-INF-04).
    #
    # `valid` resolver dan `fail_timeout` di sini menentukan JEDA_SERAH_DETIK pada
    # deploy.sh (keputusan 61): mengubah salah satunya tanpa menyesuaikan jeda itu
    # mengembalikan 502 "no live upstreams" saat deploy bergulir.
    server api-1:3000 resolve max_fails=1 fail_timeout=5s;
    server api-2:3000 resolve max_fails=1 fail_timeout=5s;
    keepalive 16;
}

server {
    listen 80;
    server_name ${SIGM4_DOMAIN};

    # Tantangan HTTP-01 certbot (SDD-INF-13).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SIGM4_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${SIGM4_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SIGM4_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;

    # INF-06 — HSTS dari proxy; header keamanan API tetap milik aplikasi (NFR-S-11).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Kompresi oleh reverse proxy, bukan aplikasi (SDD-06 §4.3).
    gzip on;
    gzip_types application/json text/css application/javascript image/svg+xml;

    location /api/ {
        proxy_pass http://sigm4_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Satu hop: `trust proxy 1` pada API membaca IP klien dari sini (NFR-S-07).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Instance yang sedang diganti tidak boleh menjadi galat bagi pengguna.
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 2;
    }

    # Web statis (SDD-FE-14) — rute sisi klien jatuh ke index.html.
    location / {
        root /usr/share/sigm4/web;
        try_files $uri $uri/ /index.html =404;
    }
}
