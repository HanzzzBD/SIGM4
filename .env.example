# Contoh variabel lingkungan PENGEMBANGAN LOKAL — salin menjadi `.env`, lalu isi.
#
#   cp .env.example .env
#
# Berkas ini TIDAK memuat rahasia maupun kata sandi: setiap `<…>` diganti
# sendiri di `.env` (yang tidak pernah di-commit). Rahasia staging/produksi datang dari secret manager,
# tidak pernah dari berkas di repositori (SEC-CFG-01, SDD-16 §4.7).
# Daftar lengkap dan keadaan akhirnya: docs/SDD/16-infrastructure-deployment.md §4.7.

# --- Basis data & cache (docker compose up --wait) ---------------------------
# Port host PostgreSQL; samakan dengan port pada DATABASE_URL di bawah.
POSTGRES_PORT=5432
# Akun pemilik skema (sigm4) — dipakai migration dan uji integrasi. Sandinya =
# POSTGRES_PASSWORD container (lihat docker-compose.yml; dapat ditimpa lewat env).
DATABASE_URL=postgres://sigm4:<sandi-postgres>@127.0.0.1:5432/sigm4?sslmode=disable
# Opsional: akun migration terpisah; kosong → jatuh kembali ke DATABASE_URL.
# MIGRATION_DATABASE_URL=
# Akun aplikasi sigm4_app (SEC-CFG-03, AL-03b). Migration memasang sandinya dari
# APP_DB_PASSWORD; keduanya harus sama. Diperlukan uji AL-03b/0012.
# Pilih sandi sendiri.
APP_DB_PASSWORD=<sandi-sigm4_app>
APP_DATABASE_URL=postgres://sigm4_app:<sandi-sigm4_app>@127.0.0.1:5432/sigm4?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379

# --- Wajib bagi API/worker (startup gagal bila kosong, SDD-INF-08) -----------
# SDD-INF-09: proses selalu berjalan dalam UTC.
TZ=UTC
# Pasangan Ed25519 PEM (PR-02-02). Satu baris dengan `\n` literal diterima:
#   openssl genpkey -algorithm ed25519 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<isi>\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<isi>\n-----END PUBLIC KEY-----\n"
# Base64 tepat 32 byte (PR-02-07): openssl rand -base64 32
# Kehilangan kunci ini = seluruh 2FA didaftarkan ulang.
TOTP_ENCRYPTION_KEY=
# Origin object storage yang dijangkau peramban/aplikasi (SDD-FS-13).
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000/sigm4/

# --- Opsional ----------------------------------------------------------------
# LOG_LEVEL=info
# DB_POOL_SIZE=
# JSON service account Firebase ber-base64 (keputusan 80a, sejak PR-02-27).
# Kosong → push dilewati; /health melaporkan fcm "degraded" tanpa memengaruhi ready.
#   base64 -w0 service-account.json
# FCM_CREDENTIALS=
